# Express Server Settings
PORT=5000
NODE_ENV=development

# MongoDB connection
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/interviewace?retryWrites=true&w=majority

# JWT signing token secret
JWT_SECRET=super_secret_jwt_sign_key_for_interviewace

# Google Gemini Integration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash


# Razorpay Integration
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Cloudinary assets storage
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Frontend Application URL
CLIENT_URL=http://localhost:5173
